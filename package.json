    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.2.3",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.93.0",
    "typescript": "^6.0.3",
